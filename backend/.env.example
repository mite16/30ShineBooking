# Copy this file to .env and adjust as needed. .env is git-ignored.

# Local MongoDB (default for this PE). Swap for a MongoDB Atlas URI later
# without touching any other code: mongodb+srv://<user>:<pass>@<cluster>/30shine
MONGODB_URI=mongodb://127.0.0.1:27017/booking30shine

PORT=4000

# Secret used to sign JWTs. Change this before deploying anywhere real.
JWT_SECRET=dev-only-change-me-30shine-prm393
JWT_EXPIRES_IN=7d
